# Configuracao do FriendsMeeting (preserve os valores ja existentes no seu .env)
POSTGRES_USER=seuUser
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=SeuBanco

# authService incorporado como servico independente no mesmo Compose.
# Pode deixar estas chaves ausentes no .env antigo para usar os padroes locais.
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_DB=auth_service
# Se omitida ou vazia, reutiliza POSTGRES_PASSWORD APENAS no ambiente local.
AUTH_POSTGRES_PASSWORD=
# Se omitida ou vazia, a API gera uma chave aleatoria e a guarda no volume auth_config.
# Para ambientes nao locais, configure este segredo explicitamente:
AUTH_SECRET_KEY=
